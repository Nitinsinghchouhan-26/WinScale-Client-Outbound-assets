<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ecommerce Coaching Market Intelligence Report — WinScale Media</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0A0C0F;
    --bg2: #10141A;
    --bg3: #161C25;
    --bg4: #1E2633;
    --border: rgba(255,255,255,0.07);
    --border-accent: rgba(182,145,89,0.3);
    --gold: #B69159;
    --gold-light: #D4AE78;
    --gold-dim: rgba(182,145,89,0.15);
    --text: #E8E4DC;
    --text-muted: #8A8880;
    --text-faint: #4A4845;
    --teal: #4A9E8E;
    --teal-dim: rgba(74,158,142,0.12);
    --coral: #C96A4A;
    --coral-dim: rgba(201,106,74,0.12);
    --blue: #4A7EB6;
    --blue-dim: rgba(74,126,182,0.12);
    --green: #5A9E6A;
    --green-dim: rgba(90,158,106,0.12);
    --red: #C45A5A;
    --red-dim: rgba(196,90,90,0.12);
    --amber: #D4943A;
    --amber-dim: rgba(212,148,58,0.12);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--gold-dim); border-radius: 2px; }

  .page-wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(10,12,15,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
  }
  .nav-inner {
    max-width: 1100px; margin: 0 auto; padding: 0 32px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .nav-brand {
    font-family: 'Playfair Display', serif;
    font-size: 13px; font-weight: 600; letter-spacing: 0.12em;
    color: var(--gold); text-transform: uppercase; text-decoration: none;
  }
  .nav-meta { font-size: 11px; color: var(--text-muted); letter-spacing: 0.06em; font-family: 'DM Mono', monospace; }

  .cover {
    min-height: 90vh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 80px 0 72px;
    position: relative; overflow: hidden;
  }
  .cover-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(182,145,89,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(182,145,89,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }
  .cover-glow {
    position: absolute; top: -20%; right: -10%;
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(182,145,89,0.06) 0%, transparent 65%);
    pointer-events: none;
  }
  .cover-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .cover-eyebrow::before {
    content: ''; display: block; width: 32px; height: 1px; background: var(--gold);
  }
  h1.cover-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700; line-height: 1.1;
    color: var(--text); margin-bottom: 12px;
  }
  h1.cover-title span { color: var(--gold); }
  .cover-subtitle {
    font-size: 17px; color: var(--text-muted);
    max-width: 560px; margin-bottom: 48px; font-weight: 300;
  }
  .cover-meta-row {
    display: flex; gap: 32px; flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 32px; margin-top: 8px;
  }
  .cover-meta-item label {
    display: block; font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-faint);
    font-family: 'DM Mono', monospace; margin-bottom: 4px;
  }
  .cover-meta-item span { font-size: 13px; color: var(--text-muted); }

  .section { padding: 80px 0; border-bottom: 1px solid var(--border); }
  .section:last-child { border-bottom: none; }

  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: var(--border-accent); max-width: 64px;
  }

  h2.section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 600; line-height: 1.2;
    color: var(--text); margin-bottom: 12px;
  }
  .section-intro {
    font-size: 15px; color: var(--text-muted);
    max-width: 680px; margin-bottom: 48px; font-weight: 300; line-height: 1.8;
  }

  .card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 12px; padding: 28px;
    transition: border-color 0.2s;
  }
  .card:hover { border-color: var(--border-accent); }
  .card-gold { border-color: var(--border-accent); background: linear-gradient(135deg, var(--bg2), var(--gold-dim)); }
  .card-teal { border-left: 3px solid var(--teal); }
  .card-coral { border-left: 3px solid var(--coral); }
  .card-blue { border-left: 3px solid var(--blue); }

  .card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 17px; font-weight: 600; color: var(--text);
    margin-bottom: 10px;
  }
  .card p { font-size: 14px; color: var(--text-muted); line-height: 1.75; }

  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  @media (max-width: 768px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
    .page-wrap { padding: 0 20px; }
  }
  @media (max-width: 960px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
    .grid-4 { grid-template-columns: repeat(2, 1fr); }
  }

  .stat-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 40px; }
  .stat-pill {
    background: var(--bg3); border: 1px solid var(--border);
    border-radius: 8px; padding: 16px 24px;
    flex: 1; min-width: 150px;
  }
  .stat-pill .num {
    font-family: 'Playfair Display', serif;
    font-size: 28px; font-weight: 700; color: var(--gold);
    display: block; line-height: 1;
  }
  .stat-pill .lbl {
    font-size: 11px; color: var(--text-muted); margin-top: 6px;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-family: 'DM Mono', monospace;
  }

  .badge {
    display: inline-block; font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 3px 10px; border-radius: 4px;
    font-family: 'DM Mono', monospace; font-weight: 500;
  }
  .badge-gold { background: var(--gold-dim); color: var(--gold-light); border: 1px solid var(--border-accent); }
  .badge-teal { background: var(--teal-dim); color: var(--teal); border: 1px solid rgba(74,158,142,0.2); }
  .badge-coral { background: var(--coral-dim); color: var(--coral); border: 1px solid rgba(201,106,74,0.2); }
  .badge-blue { background: var(--blue-dim); color: var(--blue); border: 1px solid rgba(74,126,182,0.2); }
  .badge-green { background: var(--green-dim); color: var(--green); border: 1px solid rgba(90,158,106,0.2); }
  .badge-red { background: var(--red-dim); color: var(--red); border: 1px solid rgba(196,90,90,0.2); }
  .badge-amber { background: var(--amber-dim); color: var(--amber); border: 1px solid rgba(212,148,58,0.2); }

  .table-wrap { overflow-x: auto; margin-top: 32px; }
  table.data-table {
    width: 100%; border-collapse: collapse;
    font-size: 13px;
  }
  table.data-table thead th {
    background: var(--bg3);
    padding: 12px 16px; text-align: left;
    font-family: 'DM Mono', monospace;
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-muted); border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  table.data-table tbody td {
    padding: 14px 16px; border-bottom: 1px solid var(--border);
    color: var(--text-muted); vertical-align: top; line-height: 1.6;
  }
  table.data-table tbody tr:hover td { background: var(--bg3); }
  table.data-table tbody td:first-child { color: var(--text); font-weight: 500; }
  table.data-table .highlight-row td { background: var(--gold-dim); }
  table.data-table .highlight-row td:first-child { color: var(--gold-light); }

  .funnel-container { margin-top: 24px; }
  .funnel-block {
    position: relative; display: flex; align-items: center; gap: 16px;
    margin-bottom: 6px;
  }
  .funnel-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.1em;
    width: 140px; text-align: right; flex-shrink: 0;
  }
  .funnel-bar-wrap { flex: 1; }
  .funnel-bar {
    height: 36px; border-radius: 6px; display: flex; align-items: center;
    padding: 0 14px; font-size: 12px; font-weight: 500; color: var(--text);
    transition: opacity 0.2s;
  }
  .funnel-connector {
    width: 2px; background: var(--border); height: 6px;
    margin: 0 0 0 calc(140px + 16px + 36px);
  }

  .icp-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 16px; padding: 32px; position: relative; overflow: hidden;
  }
  .icp-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  }
  .icp-1::before { background: linear-gradient(90deg, var(--gold), var(--gold-light)); }
  .icp-2::before { background: linear-gradient(90deg, var(--teal), #6EC4B5); }
  .icp-3::before { background: linear-gradient(90deg, var(--coral), #E88A6A); }

  .icp-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px; font-weight: 700; line-height: 1;
    margin-bottom: 16px; opacity: 0.15;
  }
  .icp-1 .icp-number { color: var(--gold); }
  .icp-2 .icp-number { color: var(--teal); }
  .icp-3 .icp-number { color: var(--coral); }

  .icp-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px; font-weight: 600; color: var(--text); margin-bottom: 6px;
  }
  .icp-tagline { font-size: 13px; color: var(--text-muted); margin-bottom: 24px; font-style: italic; }

  .icp-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: flex-start; }
  .icp-row-label {
    font-family: 'DM Mono', monospace; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-faint); width: 90px; flex-shrink: 0; padding-top: 2px;
  }
  .icp-row-val { font-size: 13px; color: var(--text-muted); line-height: 1.6; }

  .messaging-box {
    margin-top: 20px; padding: 16px 20px;
    border-radius: 8px; border-left: 3px solid;
  }
  .icp-1 .messaging-box { background: var(--gold-dim); border-color: var(--gold); }
  .icp-2 .messaging-box { background: var(--teal-dim); border-color: var(--teal); }
  .icp-3 .messaging-box { background: var(--coral-dim); border-color: var(--coral); }
  .messaging-box .hook-label {
    font-family: 'DM Mono', monospace; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-faint); margin-bottom: 6px;
  }
  .messaging-box .hook-text { font-size: 14px; color: var(--text); font-weight: 500; line-height: 1.5; }

  .funnel-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px; font-weight: 600; color: var(--text);
    margin: 40px 0 8px; padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .funnel-section-title .f-badge {
    font-size: 11px; font-family: 'DM Mono', monospace;
    padding: 4px 12px; border-radius: 20px; letter-spacing: 0.1em;
    text-transform: uppercase; font-weight: 500;
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px; margin-top: 32px;
  }
  .matrix-item {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 12px; padding: 24px;
    position: relative;
  }
  .matrix-item .gap-num {
    font-family: 'Playfair Display', serif;
    font-size: 36px; font-weight: 700; color: var(--gold);
    opacity: 0.2; position: absolute; top: 16px; right: 20px;
  }
  .matrix-item h4 {
    font-size: 15px; font-weight: 600; color: var(--text);
    margin-bottom: 8px;
  }
  .matrix-item p { font-size: 13px; color: var(--text-muted); line-height: 1.7; }
  .matrix-item .rec {
    margin-top: 12px; padding: 10px 14px;
    background: var(--gold-dim); border-radius: 6px;
    font-size: 12px; color: var(--gold-light); line-height: 1.5;
  }

  .step-item {
    display: flex; gap: 20px; padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .step-item:last-child { border-bottom: none; }
  .step-num {
    font-family: 'Playfair Display', serif;
    font-size: 32px; font-weight: 700; color: var(--gold);
    opacity: 0.3; flex-shrink: 0; line-height: 1; width: 40px;
  }
  .step-content h4 {
    font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 6px;
  }
  .step-content p { font-size: 13px; color: var(--text-muted); line-height: 1.75; }

  .price-band-row {
    display: flex; align-items: stretch; gap: 0;
    margin-top: 32px; border-radius: 12px; overflow: hidden;
    border: 1px solid var(--border);
  }
  .price-band {
    flex: 1; padding: 24px 20px; text-align: center;
    border-right: 1px solid var(--border);
  }
  .price-band:last-child { border-right: none; }
  .price-band.recommended { background: var(--gold-dim); border-top: 3px solid var(--gold); }
  .price-band .pb-range {
    font-family: 'Playfair Display', serif;
    font-size: 20px; font-weight: 700; color: var(--text); display: block; margin-bottom: 4px;
  }
  .price-band .pb-label {
    font-family: 'DM Mono', monospace; font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted);
    display: block; margin-bottom: 12px;
  }
  .price-band .pb-note { font-size: 12px; color: var(--text-muted); line-height: 1.6; }
  .price-band.recommended .pb-range { color: var(--gold-light); }

  .toc {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 12px; padding: 32px; margin: 48px 0;
  }
  .toc h3 {
    font-family: 'DM Mono', monospace; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--gold); margin-bottom: 20px;
  }
  .toc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .toc a {
    font-size: 13px; color: var(--text-muted); text-decoration: none;
    padding: 8px 12px; border-radius: 6px;
    transition: all 0.15s;
    display: flex; align-items: center; gap: 10px;
  }
  .toc a:hover { background: var(--bg3); color: var(--text); }
  .toc a .toc-num {
    font-family: 'DM Mono', monospace; font-size: 10px;
    color: var(--gold); opacity: 0.7; flex-shrink: 0; width: 20px;
  }

  .divider {
    height: 1px; background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
    margin: 16px 0;
  }

  .disclaimer {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 8px; padding: 16px 20px; margin-top: 24px;
    font-size: 12px; color: var(--text-faint); line-height: 1.7;
  }
  .disclaimer strong { color: var(--text-muted); }

  footer {
    padding: 48px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .footer-brand {
    font-family: 'Playfair Display', serif;
    font-size: 22px; font-weight: 600; color: var(--gold);
    margin-bottom: 8px;
  }
  .footer-note { font-size: 12px; color: var(--text-faint); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .fade-in { animation: fadeIn 0.6s ease both; }

  mark {
    background: var(--gold-dim);
    color: var(--gold-light); padding: 2px 6px;
    border-radius: 3px;
  }

  ul.check-list { list-style: none; padding: 0; }
  ul.check-list li {
    padding: 6px 0 6px 24px; position: relative;
    font-size: 13px; color: var(--text-muted); line-height: 1.65;
  }
  ul.check-list li::before {
    content: '→'; position: absolute; left: 0;
    color: var(--gold); font-size: 12px;
  }

  .notice-box {
    background: var(--bg3); border: 1px solid var(--border-accent);
    border-radius: 8px; padding: 16px 20px; margin-top: 20px;
    font-size: 13px; color: var(--text-muted); line-height: 1.7;
  }
  .notice-box strong { color: var(--gold-light); }

  .tab-row { display: flex; gap: 8px; margin-bottom: 32px; flex-wrap: wrap; }
  .tab-btn {
    padding: 8px 18px; border-radius: 6px; cursor: pointer;
    font-family: 'DM Mono', monospace; font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--bg3); border: 1px solid var(--border);
    color: var(--text-muted); transition: all 0.15s;
  }
  .tab-btn.active, .tab-btn:hover {
    background: var(--gold-dim); border-color: var(--border-accent);
    color: var(--gold-light);
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ===== UNIFIED PROJECTIONS TABLE ===== */
  .projections-outer { overflow-x: auto; margin-top: 32px; }

  .projections-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    min-width: 900px;
  }

  /* Top scenario header row */
  .projections-table .hdr-funnel {
    background: var(--bg3);
    padding: 0;
  }
  .projections-table .hdr-metric {
    background: var(--bg3);
    padding: 14px 16px;
    font-family: 'DM Mono', monospace;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text-muted);
    border-right: 1px solid var(--border);
    vertical-align: middle;
  }
  .projections-table .funnel-group-header {
    text-align: center; padding: 10px 8px;
    font-family: 'Playfair Display', serif;
    font-size: 13px; font-weight: 600; color: var(--text);
    border-right: 2px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .projections-table .funnel-group-header:last-child { border-right: none; }
  .funnel-group-header .fgh-sub {
    display: block; font-family: 'DM Mono', monospace;
    font-size: 10px; font-weight: 400; color: var(--text-muted);
    letter-spacing: 0.1em; margin-top: 3px;
  }

  /* Scenario sub-headers (Good / Average / Worst) */
  .projections-table .scenario-hdr th {
    padding: 10px 12px; text-align: center;
    font-family: 'DM Mono', monospace; font-size: 10px;
    letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600;
    border-bottom: 2px solid var(--border);
    border-right: 1px solid var(--border);
  }
  .projections-table .scenario-hdr th:last-child { border-right: none; }
  .projections-table .scenario-hdr .s-good { background: var(--green-dim); color: var(--green); border-top: 2px solid var(--green); }
  .projections-table .scenario-hdr .s-avg  { background: var(--amber-dim); color: var(--amber); border-top: 2px solid var(--amber); }
  .projections-table .scenario-hdr .s-bad  { background: var(--red-dim);   color: var(--red);   border-top: 2px solid var(--red); }

  /* Data rows */
  .projections-table tbody td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    text-align: center;
    color: var(--text-muted);
    background: var(--bg2);
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    line-height: 1.4;
  }
  .projections-table tbody td:last-child { border-right: none; }
  .projections-table tbody td.metric-label {
    text-align: left;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; font-weight: 500;
    color: var(--text);
    background: var(--bg3);
    border-right: 2px solid var(--border);
    white-space: nowrap;
  }
  .projections-table tbody tr:hover td { opacity: 0.88; }

  /* Section divider rows */
  .projections-table .section-row td {
    background: var(--bg);
    padding: 6px 16px;
    font-family: 'DM Mono', monospace; font-size: 9px;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--text-faint);
